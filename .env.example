# Pooled connection for Next.js request handlers on Vercel.
DATABASE_URL=postgresql://user:password@example-pooler.neon.tech/database?sslmode=require

# Direct connection for Drizzle migrations and operator scripts.
DATABASE_URL_UNPOOLED=postgresql://user:password@example.neon.tech/database?sslmode=require

# Long random value shared only with Vercel Cron.
CRON_SECRET=replace-with-a-random-secret
